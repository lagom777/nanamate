{
  "name": "nanamate",
  "compatibility_date": "2026-05-06",
  "workers_dev": true,
  "preview_urls": true,
  "main": "worker/index.js",
  "build": {
    "command": "node scripts/export-static.mjs"
  },
  "assets": {
    "directory": "./public/learn",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nanamate",
      "database_id": "3c8f0751-b119-44cd-b7eb-bdcfd4b9e413",
      "migrations_dir": "d1/migrations"
    }
  ]
}
