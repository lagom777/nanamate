<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.studywithai.reblog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/kg/coding/studywithai/realestate-blog/auto/run.mjs</string>
