<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.studywithai.reblog.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/kg/coding/studywithai/realestate-blog/auto/run.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kg/coding/studywithai/realestate-blog/auto</string>

  <!-- 매일 오전 9:00. 맥이 켜져·깨어 있어야 실행됨 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/kg/coding/studywithai/realestate-blog/auto/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kg/coding/studywithai/realestate-blog/auto/launchd.err.log</string>
</dict>
</plist>
