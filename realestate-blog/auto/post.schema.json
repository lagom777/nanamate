{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "title_options",
    "body_markdown",
    "body_naver",
    "info_table",
    "social",
    "social_hashtags",
    "hashtags",
    "meta_description",
    "review_notes",
    "sources_used"
  ],
  "properties": {
    "topic": { "type": "string" },
    "title_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "body_markdown": { "type": "string" },
    "body_naver": { "type": "string" },
    "info_table": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string" }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threads", "x"],
      "properties": {
        "threads": { "type": "string" },
        "x": { "type": "string" }
      }
    },
    "social_hashtags": { "type": "array", "items": { "type": "string" } },
    "hashtags": { "type": "array", "items": { "type": "string" } },
    "meta_description": { "type": "string" },
    "review_notes": { "type": "array", "items": { "type": "string" } },
    "sources_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "source", "url"],
        "properties": {
          "title": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  }
}
